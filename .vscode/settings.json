{
  // VSCode + Blender 开发配置
  // 扩展：jacqueslucke.blender-development
  //
  // 用法：
  //   1. 用 VSCode 打开这个文件夹（tools/bl-fast）
  //   2. Ctrl+Shift+P -> "Blender: Start"
  //   3. 打开 examples/ 里的脚本 -> Ctrl+Shift+P -> "Blender: Run Script"
  //
  // ⚠️ 这里刻意**不放** blender.executables 和 python.analysis.extraPaths。
  //    那两项是「每台机器都不同」的（Blender 装在哪、什么版本），
  //    放进版本库只会让所有人——包括你自己换机器之后——拿到一堆不存在的路径。
  //
  //    更要命的是 VSCode 的优先级：
  //        工作区(.vscode/settings.json)  >  用户级(%APPDATA%/Code/User)
  //    所以工作区里写错一份，会**压住**你用户级里那份正确的，
  //    然后 "Blender: Start" 失败，而错误信息**不会**告诉你用户级里其实有对的。
  //
  //    那两项请配在**用户级**：
  //        Ctrl+Shift+P -> "Preferences: Open User Settings (JSON)"
  //    配法见 INSTALL.md 的「配置 VSCode 指向你的 Blender」。

  // examples/ 里的脚本可以在扩展的 "Open Scripts Folder" 里直接看到。
  // 这是相对路径，对别人也成立，所以留在工作区里没问题。
  "blender.scripts.directories": ["examples"],

  // 保存插件源码时自动重载（做 addon 开发时有用）
  "blender.addon.reloadOnSave": false,

  // 源码统一 UTF-8 + LF（避免中文注释在 Blender 里变乱码）
  "files.encoding": "utf8",
  "files.eol": "\n",

  // 这个项目用的是 4 空格缩进
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  }
}
